<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/edScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Edit clip"
                android:textSize="22sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/edClose"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Close" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="360dp"
            android:background="#000000">

            <VideoView
                android:id="@+id/edVideo"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center" />
        </FrameLayout>

        <TextView
            android:id="@+id/edStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/accent"
            android:textSize="13sp" />

        <TextView style="@style/EdHead" android:text="Layout" />

        <Spinner
            android:id="@+id/edLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:id="@+id/edCamSec"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/EdLabel"
                android:text="Facecam: drag the box onto the person's camera, drag the yellow dot to resize" />

            <app.clipcutter.android.CamPickerView
                android:id="@+id/edCam"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button android:id="@+id/edAuto" style="@style/EdSmallBtn" android:text="Auto" />
                <Button android:id="@+id/edTL" style="@style/EdSmallBtn" android:text="↖" />
                <Button android:id="@+id/edTR" style="@style/EdSmallBtn" android:text="↗" />
                <Button android:id="@+id/edBL" style="@style/EdSmallBtn" android:text="↙" />
                <Button android:id="@+id/edBR" style="@style/EdSmallBtn" android:text="↘" />
            </LinearLayout>
        </LinearLayout>

        <TextView style="@style/EdHead" android:text="Captions" />

        <CheckBox
            android:id="@+id/edCapsOn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Show captions" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout style="@style/EdCol">
                <TextView style="@style/EdLabel" android:text="Language" />
                <Spinner android:id="@+id/edLang" android:layout_width="match_parent" android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout style="@style/EdCol">
                <TextView style="@style/EdLabel" android:text="Style" />
                <Spinner android:id="@+id/edStyle" android:layout_width="match_parent" android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout style="@style/EdCol">
                <TextView style="@style/EdLabel" android:text="Position" />
                <Spinner android:id="@+id/edPos" android:layout_width="match_parent" android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout style="@style/EdCol">
                <TextView style="@style/EdLabel" android:text="Size" />
                <Spinner android:id="@+id/edSize" android:layout_width="match_parent" android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <TextView style="@style/EdLabel" android:text="Caption words (fix mistakes here)" />

        <EditText
            android:id="@+id/edWords"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine"
            android:maxLines="6"
            android:minLines="2" />

        <TextView
            style="@style/EdLabel"
            android:text="Same number of words keeps the timing; more or fewer are spread over the clip." />

        <TextView style="@style/EdHead" android:text="Hook" />

        <EditText
            android:id="@+id/edHook"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:singleLine="true" />

        <CheckBox
            android:id="@+id/edHookText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Big hook text" />

        <CheckBox
            android:id="@+id/edReplay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Replay the best moment first" />

        <CheckBox
            android:id="@+id/edHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Small title at the top" />

        <TextView style="@style/EdHead" android:text="Post" />

        <TextView style="@style/EdLabel" android:text="Title" />

        <EditText
            android:id="@+id/edTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text" />

        <TextView style="@style/EdLabel" android:text="Caption + hashtags" />

        <EditText
            android:id="@+id/edCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine"
            android:maxLines="5" />

        <Button
            android:id="@+id/edSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/accent"
            android:text="Save &amp; render"
            android:textColor="#000000"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
